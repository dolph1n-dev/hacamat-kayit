{
  "expo": {
    "name": "hacamat-kayit",
    "slug": "hacamat-kayit",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-logo.jpeg",
        "backgroundImage": "./assets/android-icon-logo.jpeg",
        "monochromeImage": "./assets/android-icon-logo.jpeg"
      },
      "package": "com.yunus.hacamatkayit"
    },
    "web": {
      "favicon": "./assets/logo.jpeg"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Müşteriyi rehbere eklemek için kişilerinize erişim izni gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1491f509-325c-4d72-bd70-2d2cc970333e"
      }
    }
  }
}
